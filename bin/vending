#!/usr/bin/env php
<?php
declare(strict_types=1);

use App\Console\BuyCommand;
use App\Console\CollectCommand;
use App\Console\Defaults;
use App\Console\InsertCommand;
use App\Console\MachinesCommand;
use App\Console\RefundCommand;
use App\Console\ResetCommand;
use App\Console\RestockCommand;
use App\Console\ShellCommand;
use App\Console\StatusCommand;
use Framework\Console\Application;
use Framework\Console\Input;
use Framework\Console\Output;
use Framework\Container;

/** @var Container $container */
$container = require dirname(__DIR__) . '/src/bootstrap.php';

$container->set(Defaults::class, function (Container $container) {
    $cli = $container->get('config')['cli'];

    return new Defaults($cli['customer'], $cli['machine']);
});

$application = new Application('Vending Machine', new Output(STDOUT));

$commands = [
    MachinesCommand::class,
    StatusCommand::class,
    InsertCommand::class,
    BuyCommand::class,
    RefundCommand::class,
    RestockCommand::class,
    CollectCommand::class,
    ResetCommand::class,
];

foreach ($commands as $command) {
    $application->add($container->get($command));
}

$application->add(new ShellCommand($application));

exit($application->run(new Input(array_slice($argv, 1))));
